  "lines": [
   {
    "id": "h1",
    "who": "hikmet",
    "gap": 0.3,
    "text": "Defne iki gün de Necmi'yi yendi, ama toplamda kaybetti!",
    "tts": "Defne iki gün de Necmiyi yendi, ama toplamda kaybetti!"
   },
   {
    "id": "h2a",
    "who": "hikmet",
    "gap": 0.3,
    "text": "Kutu Pazartesi kapının yanındaydı, Salı masanın dibindeydi."
   },
   {
    "id": "h2b",
    "who": "hikmet",
    "gap": 0.3,
    "text": "İkisi de on atış yaptı. Necmi altı, Defne dört soktu. Bu nasıl olur?"
   },
   {
    "id": "d2",
    "who": "defne",
    "gap": 0.5,
    "text": "Necmi yanlış saymıştır, hesapta hata var!"
   },
   {
    "id": "hd",
    "who": "hikmet",
    "gap": 0.45,
    "text": "Hesap doğru. Senin dört topun girdi, Necmi'nin altı.",
    "tts": "Hesap doğru. Senin dört topun girdi, Necminin altı."
   },
   {
    "id": "n1",
    "who": "necmi",
    "gap": 5.6,
    "text": "Ben toplarımın çoğunu kutu masama gelince attım."
   },
   {
    "id": "d3",
    "who": "defne",
    "gap": 0.32,
    "text": "Buldum! Atışlar günlere eşit dağılmadı!"
   },
   {
    "id": "d4",
    "who": "defne",
    "gap": 0.35,
    "text": "Ben sekiz topu uzak kutuya attım, Necmi sekizini yakın kutuya attı."
   },
   {
    "id": "d5",
    "who": "defne",
    "gap": 0.35,
    "text": "Her gün ben daha iyiyim, ama toplamda zor gün ağır bastı."
   },
   {
    "id": "h4",
    "who": "hikmet",
    "gap": 1,
    "text": "Bundan sonra kutu kapının dışında duracak!"
   },
   {
    "id": "d6",
    "who": "defne",
    "gap": 0.7,
    "text": "Bunu ortalamaya güvenen arkadaşına gönder."
   }

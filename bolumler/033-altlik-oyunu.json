    "who": "hikmet",
    "gap": 0.3,
    "text": "Defne, bu masada beni kimse yenemez!"
   },
   {
    "id": "h2a",
    "who": "hikmet",
    "gap": 0.3,
    "text": "Sırayla altlık koyacağız. Üst üste binmek, masadan taşmak yok."
   },
   {
    "id": "h2b",
    "who": "hikmet",
    "gap": 0.3,
    "text": "Altlığını koyacak yer bulamayan kaybeder. İlk hamle senin."
   },
   {
    "id": "h3",
    "who": "hikmet",
    "gap": 0.4,
    "text": "Sen kazanırsan çaylar benden."
   },
   {
    "id": "d2",
    "who": "defne",
    "gap": 0.5,
    "text": "Kenarlardan başlarım, size yer kalmaz!"

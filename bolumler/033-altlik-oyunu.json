   {
    "id": "hd",
    "who": "hikmet",
    "gap": 0.45,
    "text": "Yine boşluk buldum. Son yer benim!"
   },
   {
    "id": "n1",
    "who": "necmi",
    "gap": 5.6,
    "text": "Ben sofrayı ortadan kurarım. Sağına ne koyarsam soluna da aynısını koyarım."
   },
   {
    "id": "d3",
    "who": "defne",
    "gap": 0.32,
    "text": "Buldum! İlk altlık tam ortaya gider!"
   },
   {
    "id": "d4",
    "who": "defne",
    "gap": 0.35,
    "text": "Sonra siz nereye koyarsanız, ben ortanın tam karşısına koyarım."
   },
   {
    "id": "d5",
    "who": "defne",
    "gap": 0.35,
    "text": "Siz yer buldukça benim de yerim olur. Son yer benim!"
   },
   {
    "id": "h4",
    "who": "hikmet",
    "gap": 1,
    "text": "Çaylar benden. Ama altlıkları sen topluyorsun."
   },
   {
    "id": "d6",
    "who": "defne",
    "gap": 0.7,
    "text": "Bunu masada hep kazanan arkadaşına gönder."
